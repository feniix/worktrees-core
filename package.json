{
  "name": "@feniix/worktrees-core",
  "version": "0.1.0",
  "description": "Shared TypeScript library for git worktree management primitives and higher-level workspace workflows",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck",
    "check:ci": "biome ci . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "git",
    "worktree",
    "typescript",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feniix/worktrees-core.git"
  },
  "author": "feniix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/feniix/worktrees-core/issues"
  },
  "homepage": "https://github.com/feniix/worktrees-core#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  }
}
